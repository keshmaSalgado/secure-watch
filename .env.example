# =============================================================================
# SecureWatch Configuration Environment Variables
# =============================================================================

# ASP.NET Core Environment (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT=Production

# Database Configuration (PostgreSQL)
POSTGRES_DB=securewatch
POSTGRES_USER=securewatch_user
POSTGRES_PASSWORD=SecureWatchDbPass2026!
POSTGRES_PORT=5432

# Redis Cache & Backplane Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=SecureWatchRedis2026!

# JWT Token Security Settings
# Must be at least 256 bits (32+ characters)
JWT_SECRET=SuperSecretKeyForSecureWatchEnterprisePlatformJwt2026!Min32Bytes
JWT_ISSUER=SecureWatchAuthServer
JWT_AUDIENCE=SecureWatchAudience
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# Python AI Service Settings
AI_SERVICE_URL=http://ai-service:8000
LLM_PROVIDER=heuristic
# Optional: Provide OpenAI or Gemini API Key for dynamic natural language explanations
OPENAI_API_KEY=

# Ports
BACKEND_PORT=5000
AI_SERVICE_PORT=8000
FRONTEND_PORT=80

